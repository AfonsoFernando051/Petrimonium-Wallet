# Copy this file to android/key.properties (already gitignored — never commit the real one)
# and fill it in with your real release keystore, generated with:
#
#   keytool -genkey -v -keystore ~/petrimonium-release.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias petrimonium
#
# Store the keystore file and these passwords in a secrets manager, not in the repo.
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=petrimonium
storeFile=/absolute/path/to/petrimonium-release.jks
